
import streamlit as st
import json
import os
from datetime import date, datetime

ARQUIVO = "tarefas.json"

st.set_page_config(
    page_title="TaskFlow",
    page_icon="📋",
    layout="centered"
)

# ESTILO VISUAL
st.markdown("""
<style>
.stApp {
    background: #101522;
    color: white;
}
h1, h2, h3, p, label {
    color: white !important;
}
section[data-testid="stSidebar"] {
    background: #1b2638;
}
div[data-testid="stMetric"] {
    background: #1c2638;
    padding: 15px;
    border-radius: 12px;
}
div.stButton > button {
    border-radius: 10px;
    font-weight: bold;
}
</style>
""", unsafe_allow_html=True)


# CARREGAR TAREFAS
def carregar():
    if os.path.exists(ARQUIVO):
        try:
            with open(ARQUIVO, "r", encoding="utf-8") as f:
                return json.load(f)
        except:
            return []
    return []


def salvar():
    with open(ARQUIVO, "w", encoding="utf-8") as f:
        json.dump(
            st.session_state.tarefas,
            f,
            ensure_ascii=False,
            indent=4
        )


if "tarefas" not in st.session_state:
    st.session_state.tarefas = carregar()


# CABEÇALHO
st.title("📋 TaskFlow")
st.caption("Seu dia organizado. Suas metas em movimento.")

tarefas = st.session_state.tarefas

total = len(tarefas)
concluidas = sum(t["concluida"] for t in tarefas)
pendentes = total - concluidas

# INDICADORES
st.divider()

col1, col2, col3 = st.columns(3)

col1.metric("📌 Total", total)
col2.metric("⏳ Pendentes", pendentes)
col3.metric("✅ Feitas", concluidas)

if total > 0:
    progresso = concluidas / total
    st.write("Progresso geral")
    st.progress(progresso)
    st.caption(f"{int(progresso * 100)}% concluído")

st.divider()


# ADICIONAR TAREFA
st.subheader("➕ Nova tarefa")

with st.form("form_tarefa", clear_on_submit=True):

    nome = st.text_input(
        "Nome da tarefa",
        placeholder="Ex: Estudar matemática"
    )

    descricao = st.text_area(
        "Descrição (opcional)",
        placeholder="Detalhes da tarefa..."
    )

    prazo = st.date_input(
        "Data de entrega",
        value=date.today(),
        format="DD/MM/YYYY"
    )

    prioridade = st.selectbox(
        "Prioridade",
        ["Baixa", "Média", "Alta"]
    )

    adicionar = st.form_submit_button(
        "➕ Adicionar tarefa",
        use_container_width=True
    )

    if adicionar:
        if nome.strip():

            tarefas.append({
                "nome": nome.strip(),
                "descricao": descricao.strip(),
                "prazo": prazo.strftime("%d/%m/%Y"),
                "prioridade": prioridade,
                "concluida": False
            })

            salvar()
            st.success("Tarefa adicionada!")
            st.rerun()

        else:
            st.warning("Digite o nome da tarefa.")


st.divider()


# LISTA DE TAREFAS
st.subheader("📝 Minhas tarefas")

filtro = st.selectbox(
    "Filtrar por:",
    ["Todas", "Pendentes", "Concluídas", "Alta prioridade"]
)

if not tarefas:
    st.info("Você ainda não possui tarefas.")

for i, tarefa in enumerate(tarefas):

    if filtro == "Pendentes" and tarefa["concluida"]:
        continue

    if filtro == "Concluídas" and not tarefa["concluida"]:
        continue

    if filtro == "Alta prioridade" and tarefa["prioridade"] != "Alta":
        continue

    cores = {
        "Baixa": "🟢",
        "Média": "🟡",
        "Alta": "🔴"
    }

    with st.container(border=True):

        status = "✅" if tarefa["concluida"] else "⬜"

        st.markdown(
            f"### {status} {tarefa['nome']}"
        )

        if tarefa["descricao"]:
            st.write(tarefa["descricao"])

        st.caption(
            f"📅 Prazo: {tarefa['prazo']}  |  "
            f"{cores[tarefa['prioridade']]} "
            f"Prioridade: {tarefa['prioridade']}"
        )

        col_a, col_b = st.columns(2)

        with col_a:
            texto = (
                "Desmarcar"
                if tarefa["concluida"]
                else "Concluir"
            )

            if st.button(texto, key=f"concluir_{i}",
                         use_container_width=True):

                tarefa["concluida"] = not tarefa["concluida"]
                salvar()
                st.rerun()

        with col_b:
            if st.button("🗑️ Excluir",
                         key=f"excluir_{i}",
                         use_container_width=True):

                tarefas.pop(i)
                salvar()
                st.rerun()


# RODAPÉ
st.divider()

st.caption(
    "TaskFlow © 2026 | Organize suas tarefas e conquiste seus objetivos."
)
